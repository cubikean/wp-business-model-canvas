    "step_4": "Gotenberg retourne le PDF généré",
    "step_5": "Servir le PDF à l'utilisateur ou le stocker"
  },
  "gotenberg_curl_example": "curl -X POST http://gotenberg:3000/forms/chromium/convert/html -F 'files=@index.html' -F 'paperWidth=11.7' -F 'paperHeight=8.3' -F 'landscape=true' -F 'printBackground=true' --output canvas.pdf"
